{
  "name": "haven-ui",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.12.1",
  "engines": {
    "node": "24.21.0",
    "pnpm": "12.12.1"
  },
  "scripts": {
    "dev": "node ../scripts/dev-vite.ts",
    "build": "vite build && node scripts/writeCspManifest.mjs",
    "preview": "vite preview",
    "check": "svelte-check --tsgo",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "profile:session-reducer": "node scripts/profileSessionReducer.ts"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/svelte": "^5.4.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  },
  "type": "module",
  "dependencies": {
    "@tauri-apps/api": "^2.12.3",
    "highlight.js": "^11.11.1",
    "markdown-it": "^15.0.2"
  }
}
